{
  "name": "mdweb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A static Markdown reader with portable document links",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npm run build && node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "wrangler": "^4.146.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
